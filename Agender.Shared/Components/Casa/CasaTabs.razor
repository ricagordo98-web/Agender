@inject IJSRuntime JS

<ScrollArrows Class="cs-tabs-wrap">
<nav class="cs-tabs" aria-label="Secções da casa" @ref="_nav">
    @foreach (TabItem tab in Tabs)
    {
        <NavLink class="cs-tab" href="@tab.Href" Match="@tab.Match">
            <Icon Name="tab.Icon" Size="16" />
            <span>@tab.Label</span>
        </NavLink>
    }
</nav>
</ScrollArrows>

@code {
    private ElementReference _nav;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        try
        {
            await using IJSObjectReference module = await JS.InvokeAsync<IJSObjectReference>("import", "./_content/Agender.Shared/viewport.js");
            await module.InvokeVoidAsync("revealActive", _nav);
        }
        catch (Exception ex) when (ex is JSDisconnectedException or JSException or TaskCanceledException)
        {
        }
    }

    private record TabItem(string Href, string Label, IconName Icon, NavLinkMatch Match);

    private static readonly TabItem[] Tabs =
    [
        new("casa", "Resumo", IconName.Home, NavLinkMatch.All),
        new("casa/compras", "Compras", IconName.Cart, NavLinkMatch.Prefix),
        new("casa/refeicoes", "Refeições", IconName.Utensils, NavLinkMatch.Prefix),
        new("casa/inventario", "Inventário", IconName.Archive, NavLinkMatch.Prefix),
        new("casa/obras", "Obras", IconName.Hammer, NavLinkMatch.Prefix),
        new("casa/limpezas", "Limpezas", IconName.Sparkles, NavLinkMatch.Prefix),
        new("casa/financas", "Finanças", IconName.Wallet, NavLinkMatch.Prefix),
        new("casa/eventos", "Agenda da casa", IconName.Calendar, NavLinkMatch.Prefix),
        new("casa/casamento", "Casamento", IconName.Heart, NavLinkMatch.Prefix)
    ];
}
