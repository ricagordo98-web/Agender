@inject ITraderIntegrationService Integration
@inject IToastService Toasts
@inject IJSRuntime JS

@if (!_loaded)
{
    <p class="hint">A carregar…</p>
}
else
{
    <p class="hint">
        O Trader envia para aqui as tuas trades. Gera uma chave, copia-a e cola-a no Trader (Configurações → Agender), junto com o endereço deste servidor.
        A chave só serve para enviar trades à tua conta e pode ser removida a qualquer momento.
    </p>

    @if (_status is { HasKey: true } status)
    {
        <p class="hint">
            Ligação ativa desde @status.KeyCreatedAt?.ToLocalTime().ToString("dd/MM/yyyy HH:mm").
            @if (status.LastSyncAt is { } last)
            {
                <span>Última sincronização: @last.ToLocalTime().ToString("dd/MM/yyyy HH:mm") · @status.TradeCount trades.</span>
            }
            else
            {
                <span>Ainda não chegou nenhuma trade.</span>
            }
        </p>
    }
    else
    {
        <p class="hint">Ainda não há nenhuma ligação com o Trader.</p>
    }

    @if (_newKey is not null)
    {
        <div class="key-box">
            <input class="field" type="text" readonly value="@_newKey" aria-label="Chave do Trader" />
            <button type="button" class="btn btn-primary" @onclick="CopyAsync">Copiar</button>
        </div>
        <p class="hint notice">Esta chave só aparece agora. Se a perderes, gera outra (a anterior deixa de funcionar).</p>
    }

    <div class="account-actions">
        <button type="button" class="btn btn-primary" disabled="@_busy" @onclick="CreateAsync">
            @(_status?.HasKey == true ? "Gerar nova chave" : "Gerar chave")
        </button>
        @if (_status?.HasKey == true)
        {
            <button type="button" class="btn btn-danger" disabled="@_busy" @onclick="RevokeAsync">Remover ligação</button>
        }
    </div>
}

@code {
    private TraderIntegrationStatus? _status;
    private string? _newKey;
    private bool _loaded;
    private bool _busy;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _status = await Integration.GetStatusAsync();
        }
        catch (Exception ex) when (IsExpected(ex))
        {
            Toasts.Show("Não foi possível carregar a ligação ao Trader.", ToastKind.Error);
        }

        _loaded = true;
    }

    private async Task CreateAsync()
    {
        _busy = true;

        try
        {
            _newKey = (await Integration.CreateKeyAsync()).Key;
            _status = await Integration.GetStatusAsync();
        }
        catch (Exception ex) when (IsExpected(ex))
        {
            Toasts.Show("Não foi possível gerar a chave.", ToastKind.Error);
        }

        _busy = false;
    }

    private async Task RevokeAsync()
    {
        _busy = true;

        try
        {
            await Integration.RevokeKeyAsync();
            _newKey = null;
            _status = await Integration.GetStatusAsync();
            Toasts.Show("Ligação removida. As trades já guardadas mantêm-se.", ToastKind.Success);
        }
        catch (Exception ex) when (IsExpected(ex))
        {
            Toasts.Show("Não foi possível remover a ligação.", ToastKind.Error);
        }

        _busy = false;
    }

    private async Task CopyAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", _newKey);
            Toasts.Show("Chave copiada.", ToastKind.Success);
        }
        catch (JSException)
        {
            Toasts.Show("Não foi possível copiar. Seleciona a chave e copia manualmente.", ToastKind.Error);
        }
    }

    private static bool IsExpected(Exception ex) =>
        ex is ArgumentException or NotFoundException or PersistenceException or ServerUnavailableException or UnauthorizedAccessException;
}
