@using Agender.Shared.Reports
@using Microsoft.Extensions.DependencyInjection
@inject IIncomeService IncomeService
@inject ITraderTradeService TradeService
@inject IToastService Toasts
@inject IJSRuntime JS
@inject IServiceProvider Services
@implements IAsyncDisposable

<Modal Title="Exportar relatório PDF" OnClose="OnClose" OnSubmit="ExportAsync">
    <ChildContent>
        <div class="cs-field">
            <span>Fontes</span>
            <div class="cs-chips" role="group" aria-label="Fontes">
                <button type="button" class="cs-chip @(AllSelected ? "on" : string.Empty)" aria-pressed="@(AllSelected ? "true" : "false")" @onclick="SelectAll">Todas</button>
                @foreach (LedgerSource source in AllSources)
                {
                    bool on = _selected.Contains(source.Key);

                    <button type="button" class="cs-chip @(on ? "on" : string.Empty)" aria-pressed="@(on ? "true" : "false")" @onclick="() => Toggle(source.Key)">
                        <i class="wk-dot" style="background:@source.Color"></i> @source.Name
                    </button>
                }
            </div>
        </div>

        <div class="cs-field">
            <span>Período</span>
            <div class="cs-chips" role="radiogroup" aria-label="Período">
                @foreach ((ExportPeriod period, string label) in Periods)
                {
                    <button type="button" role="radio" class="cs-chip @(_period == period ? "on" : string.Empty)" aria-checked="@(_period == period ? "true" : "false")" @onclick="() => _period = period">@label</button>
                }
            </div>
        </div>

        @if (_period == ExportPeriod.Custom)
        {
            <div class="cs-two">
                <label class="cs-field">De
                    <input class="field" type="date" @bind="_from" />
                </label>
                <label class="cs-field">Até
                    <input class="field" type="date" @bind="_to" />
                </label>
            </div>
        }

        <label class="cs-check">
            <input type="checkbox" @bind="_includeDetail" />
            Incluir a lista detalhada de todos os registos e trades
        </label>

        <p class="cs-hint">@PeriodSummary</p>
    </ChildContent>
    <Footer>
        <span class="spacer"></span>
        <button type="button" class="btn btn-ghost" @onclick="OnClose">Cancelar</button>
        <button type="button" class="btn btn-primary" disabled="@(_busy || _selected.Count == 0 || Range.To < Range.From)" @onclick="ExportAsync">
            <Icon Name="IconName.Download" Size="16" /> @(_busy ? "A gerar…" : "Descarregar PDF")
        </button>
    </Footer>
</Modal>

@code {
    private const int TradeChunkDays = 365;

    private enum ExportPeriod { ThisMonth, LastMonth, ThisYear, Last12Months, Custom }

    private static readonly (ExportPeriod Period, string Label)[] Periods =
    [
        (ExportPeriod.ThisMonth, "Este mês"),
        (ExportPeriod.LastMonth, "Mês passado"),
        (ExportPeriod.ThisYear, "Este ano"),
        (ExportPeriod.Last12Months, "Últimos 12 meses"),
        (ExportPeriod.Custom, "Datas à escolha")
    ];

    private readonly HashSet<string> _selected = [];
    private ExportPeriod _period = ExportPeriod.ThisMonth;
    private DateOnly _from;
    private DateOnly _to;
    private bool _includeDetail = true;
    private bool _busy;
    private IJSObjectReference? _module;

    [Parameter]
    public IReadOnlyList<IncomeSourceDto> Sources { get; set; } = [];

    [Parameter]
    public string? Preselected { get; set; }

    [Parameter]
    public DateOnly Today { get; set; } = DateOnly.FromDateTime(DateTime.Today);

    [Parameter]
    public EventCallback OnClose { get; set; }

    private IReadOnlyList<LedgerSource> AllSources => [IncomeLedger.TradesSource, .. Sources.Select(IncomeLedger.ToSource)];

    private bool AllSelected => _selected.Count == AllSources.Count;

    private (DateOnly From, DateOnly To) Range => _period switch
    {
        ExportPeriod.ThisMonth => (IncomeLedger.MonthStart(Today), IncomeLedger.MonthEnd(Today)),
        ExportPeriod.LastMonth => (IncomeLedger.MonthStart(Today).AddMonths(-1), IncomeLedger.MonthStart(Today).AddDays(-1)),
        ExportPeriod.ThisYear => (new DateOnly(Today.Year, 1, 1), new DateOnly(Today.Year, 12, 31)),
        ExportPeriod.Last12Months => (IncomeLedger.MonthStart(Today).AddMonths(-11), IncomeLedger.MonthEnd(Today)),
        _ => (_from, _to)
    };

    private string PeriodSummary
    {
        get
        {
            (DateOnly from, DateOnly to) = Range;

            return to < from
                ? "A data final tem de ser depois da inicial."
                : $"De {from.ToString("d MMM yyyy", WorkFormat.Culture)} a {to.ToString("d MMM yyyy", WorkFormat.Culture)} · {WorkFormat.Count(_selected.Count, "fonte", "fontes")}";
        }
    }

    protected override void OnInitialized()
    {
        _from = IncomeLedger.MonthStart(Today);
        _to = Today;

        if (Preselected is not null && AllSources.Any(s => s.Key == Preselected))
        {
            _selected.Add(Preselected);
        }
        else
        {
            SelectAll();
        }
    }

    private void SelectAll()
    {
        _selected.Clear();
        _selected.UnionWith(AllSources.Select(s => s.Key));
    }

    private void Toggle(string key)
    {
        if (!_selected.Remove(key))
        {
            _selected.Add(key);
        }
    }

    private async Task ExportAsync()
    {
        (DateOnly from, DateOnly to) = Range;

        if (_busy || _selected.Count == 0 || to < from)
        {
            return;
        }

        _busy = true;

        try
        {
            List<LedgerSource> sources = [.. AllSources.Where(s => _selected.Contains(s.Key))];
            bool withTrades = _selected.Contains(IncomeLedger.TradesKey);
            IReadOnlyList<IncomeEntryDto> entries = sources.Any(s => !s.IsTrades) ? await IncomeService.GetEntriesAsync(from, to) : [];
            List<TraderTradeDto> trades = withTrades ? await LoadTradesAsync(from, to) : [];

            List<IncomeEntryDto> pending = [.. entries.Where(e => e.Status == IncomeEntryStatus.Pending && _selected.Contains(IncomeLedger.SourceKey(e.SourceId)))];
            IncomeReportInput input = new(from, to, sources, IncomeLedger.Build(entries, trades), trades, _includeDetail, DateTime.Now, pending);
            string fileName = $"rendimentos-{from:yyyy-MM-dd}_{to:yyyy-MM-dd}.pdf";
            await DownloadAsync(fileName, IncomePdf.Build(input));
            await OnClose.InvokeAsync();
        }
        catch (Exception ex) when (ex is ArgumentException or NotFoundException or PersistenceException or ServerUnavailableException or UnauthorizedAccessException or JSException or IOException or InvalidOperationException)
        {
            Toasts.Show("Não foi possível gerar o PDF.", ToastKind.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task<List<TraderTradeDto>> LoadTradesAsync(DateOnly from, DateOnly to)
    {
        Dictionary<Guid, TraderTradeDto> trades = [];

        for (DateOnly start = from; start <= to; start = start.AddDays(TradeChunkDays))
        {
            DateOnly end = start.AddDays(TradeChunkDays - 1) < to ? start.AddDays(TradeChunkDays - 1) : to;

            foreach (TraderTradeDto trade in await TradeService.GetRangeAsync(start, end))
            {
                trades[trade.Id] = trade;
            }
        }

        return [.. trades.Values.Where(t => t.IsClosed)];
    }

    private async Task DownloadAsync(string fileName, byte[] pdf)
    {
        if (Services.GetService<INativeFileSaver>() is INativeFileSaver native)
        {
            await native.SaveAsync(fileName, "application/pdf", pdf);
            return;
        }

        _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./_content/Agender.Shared/Pages/Reports.razor.js");
        using MemoryStream stream = new(pdf);
        using DotNetStreamReference reference = new(stream);
        await _module.InvokeVoidAsync("downloadFile", fileName, "application/pdf", reference);
    }

    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            try
            {
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
        }
    }
}
