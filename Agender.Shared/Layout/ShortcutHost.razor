@implements IAsyncDisposable
@inject IJSRuntime JS
@inject PaletteState Palette

@code {
    private IJSObjectReference? _module;
    private DotNetObjectReference<ShortcutHost>? _self;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        _module = await JS.InvokeAsync<IJSObjectReference>("import", "./_content/Agender.Shared/Layout/ShortcutHost.razor.js");
        _self = DotNetObjectReference.Create(this);
        await _module.InvokeVoidAsync("init", _self);
    }

    [JSInvokable]
    public void OnShortcut(Shortcut shortcut)
    {
        if (shortcut == Shortcut.Palette)
        {
            Palette.Toggle();
        }
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            if (_module is not null)
            {
                await _module.InvokeVoidAsync("dispose");
                await _module.DisposeAsync();
            }
        }
        catch (JSDisconnectedException)
        {
        }

        _self?.Dispose();
    }
}
