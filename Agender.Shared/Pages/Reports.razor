@page "/relatorios"
@attribute [Authorize]
@implements IAsyncDisposable
@using Agender.Shared.Reports
@inject AgendaStore Store
@inject ITimeEntryService TimeEntryService
@inject IJSRuntime JS
@inject IToastService Toasts

<PageTitle>Relatórios · Agender</PageTitle>

<div class="page">
    <PageHeader Title="Relatórios" Subtitle="Percebe onde gastas o teu tempo e exporta para faturar.">
        <button type="button" class="btn btn-ghost" disabled="@(_filtered.Count == 0)" @onclick="ExportCsvAsync">
            <Icon Name="IconName.Download" Size="16" /> Exportar CSV
        </button>
        <button type="button" class="btn btn-ghost" disabled="@(_filtered.Count == 0)" @onclick="ExportPdfAsync">
            <Icon Name="IconName.Download" Size="16" /> Exportar PDF
        </button>
        <button type="button" class="btn btn-primary" disabled="@(_filtered.Count == 0)" @onclick="ExportXlsxAsync">
            <Icon Name="IconName.Download" Size="16" /> Exportar XLSX
        </button>
    </PageHeader>

    <section class="card report-filters">
        <div class="presets">
            <button type="button" class="btn btn-ghost" @onclick="() => SetPeriodAsync(ReportPeriod.ThisWeek(Store.Today))">Esta semana</button>
            <button type="button" class="btn btn-ghost" @onclick="() => SetPeriodAsync(ReportPeriod.LastWeek(Store.Today))">Semana passada</button>
            <button type="button" class="btn btn-ghost" @onclick="() => SetPeriodAsync(ReportPeriod.ThisMonth(Store.Today))">Este mês</button>
            <button type="button" class="btn btn-ghost" @onclick="() => SetPeriodAsync(ReportPeriod.LastMonth(Store.Today))">Mês passado</button>
        </div>

        <div class="filter-row">
            <label>De
                <input type="date" class="field" @bind="_from" @bind:after="LoadAsync" />
            </label>
            <label>Até
                <input type="date" class="field" @bind="_to" @bind:after="LoadAsync" />
            </label>
            <label>Projeto
                <select class="field" @bind="_projectId" @bind:after="Rebuild">
                    <option value="">Todos</option>
                    @foreach (Project project in Store.Projects)
                    {
                        <option value="@project.Id">@project.Name</option>
                    }
                </select>
            </label>
            <label>Etiqueta
                <select class="field" @bind="_tag" @bind:after="Rebuild">
                    <option value="">Todas as etiquetas</option>
                    @foreach (string tag in Store.Tags)
                    {
                        <option value="@tag">@tag</option>
                    }
                </select>
            </label>
            <label>Agrupar por
                <select class="field" @bind="_groupBy" @bind:after="Rebuild">
                    <option value="@ReportGroupBy.ClientProject">Cliente e projeto</option>
                    <option value="@ReportGroupBy.Project">Projeto</option>
                    <option value="@ReportGroupBy.Tag">Etiqueta</option>
                    <option value="@ReportGroupBy.Day">Dia</option>
                </select>
            </label>
        </div>
    </section>

    @if (_loading)
    {
        <div class="card report-skeleton" aria-busy="true"></div>
    }
    else if (_filtered.Count == 0)
    {
        <EmptyState Symbol="IconName.BarChart" Title="Sem registos neste período"
                    Description="Ajusta o período ou os filtros para ver o tempo registado." />
    }
    else
    {
        <section class="card report-table" aria-label="Totais">
            @foreach (ReportGroup group in _result.Groups)
            {
                @if (group.Children.Count == 0)
                {
                    <div class="report-row">
                        <span class="label">@group.Label</span>
                        <span class="num">@TimeText.Duration(group.Minutes)</span>
                        <span class="num muted">@ReportExporter.Hours(group.Minutes) h</span>
                    </div>
                }
                else
                {
                    <details open>
                        <summary class="report-row group">
                            <span class="label">@group.Label</span>
                            <span class="num">@TimeText.Duration(group.Minutes)</span>
                            <span class="num muted">@ReportExporter.Hours(group.Minutes) h</span>
                        </summary>
                        @foreach (ReportGroup child in group.Children)
                        {
                            <div class="report-row child">
                                <span class="label">@child.Label</span>
                                <span class="num">@TimeText.Duration(child.Minutes)</span>
                                <span class="num muted">@ReportExporter.Hours(child.Minutes) h</span>
                            </div>
                        }
                    </details>
                }
            }

            <div class="report-row total">
                <span class="label">Total</span>
                <span class="num">@TimeText.Duration(_result.TotalMinutes)</span>
                <span class="num muted">@ReportExporter.Hours(_result.TotalMinutes) h</span>
            </div>

            @if (_groupBy == ReportGroupBy.Tag)
            {
                <p class="hint">Um registo com várias etiquetas conta em cada uma, por isso o total não é a soma dos grupos.</p>
            }
        </section>
    }
</div>

@code {
    private DateOnly _from;
    private DateOnly _to;
    private ReportGroupBy _groupBy = ReportGroupBy.ClientProject;
    private Guid? _projectId;
    private string? _tag;
    private IReadOnlyList<TimeEntry> _entries = [];
    private IReadOnlyList<TimeEntry> _filtered = [];
    private ReportResult _result = new(0, []);
    private bool _loading = true;
    private IJSObjectReference? _module;

    protected override async Task OnInitializedAsync()
    {
        await Store.InitializeAsync();
        (_from, _to) = ReportPeriod.ThisMonth(Store.Today);
        await LoadAsync();
    }

    private Task SetPeriodAsync((DateOnly From, DateOnly To) period)
    {
        (_from, _to) = period;
        return LoadAsync();
    }

    private async Task LoadAsync()
    {
        if (_to < _from)
        {
            _entries = [];
            _loading = false;
            Rebuild();
            return;
        }

        _loading = true;

        try
        {
            _entries = await TimeEntryService.GetRangeAsync(_from, _to);
        }
        catch (Exception ex) when (ex is ServerUnavailableException or PersistenceException or UnauthorizedAccessException)
        {
            _entries = [];
            Toasts.Show("Não foi possível carregar os registos.", ToastKind.Error);
        }

        _loading = false;
        Rebuild();
    }

    private void Rebuild()
    {
        _filtered = ReportBuilder.Filter(_entries, _projectId, _tag);
        _result = ReportBuilder.Build(_filtered, Store.Projects, _groupBy);
    }

    private Task ExportCsvAsync() =>
        DownloadAsync("csv", "text/csv", () => ReportExporter.ToCsv(_filtered, Store.Projects));

    private Task ExportXlsxAsync() =>
        DownloadAsync("xlsx", "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
            () => ReportExporter.ToXlsx(_filtered, Store.Projects, _result));

    private Task ExportPdfAsync()
    {
        string? projectName = _projectId is Guid id ? Store.Projects.FirstOrDefault(p => p.Id == id)?.Name : null;
        string groupLabel = _groupBy switch
        {
            ReportGroupBy.ClientProject => "Cliente e projeto",
            ReportGroupBy.Project => "Projeto",
            ReportGroupBy.Tag => "Etiqueta",
            _ => "Dia"
        };

        ReportPdfOptions options = new(_from, _to, groupLabel, projectName, _tag, DateTime.Now);

        return DownloadAsync("pdf", "application/pdf", () => ReportPdf.Build(_filtered, Store.Projects, _result, options));
    }

    private async Task DownloadAsync(string extension, string contentType, Func<byte[]> build)
    {
        try
        {
            _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./_content/Agender.Shared/Pages/Reports.razor.js");
            using MemoryStream stream = new(build());
            using DotNetStreamReference reference = new(stream);
            await _module.InvokeVoidAsync("downloadFile", $"agender-{_from:yyyy-MM-dd}_{_to:yyyy-MM-dd}.{extension}", contentType, reference);
        }
        catch (JSException)
        {
            Toasts.Show("Não foi possível exportar o ficheiro.", ToastKind.Error);
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            try
            {
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
        }
    }
}
