@page "/conta/palavra-passe"
@attribute [Authorize]
@layout AuthLayout
@inject UserManager<AgenderUser> UserManager
@inject SignInManager<AgenderUser> SignInManager
@inject NavigationManager Navigation

<PageTitle>Alterar palavra-passe · Agender</PageTitle>

<h1>Alterar palavra-passe</h1>
<p class="auth-lead">Escolhe uma palavra-passe nova para a tua conta.</p>

@if (_done)
{
    <p class="auth-success" role="status">Palavra-passe alterada com sucesso.</p>
}

@if (_errors.Count > 0)
{
    <ul class="auth-error" role="alert">
        @foreach (string error in _errors)
        {
            <li>@error</li>
        }
    </ul>
}

<EditForm Model="Input" FormName="change-password" OnValidSubmit="ChangeAsync" method="post" class="auth-form">
    <DataAnnotationsValidator />

    <div class="auth-field">
        <label for="current">Palavra-passe atual</label>
        <InputText id="current" class="field" @bind-Value="Input.CurrentPassword" type="password" autocomplete="current-password" autofocus />
        <ValidationMessage For="() => Input.CurrentPassword" class="auth-validation" />
    </div>

    <div class="auth-field">
        <label for="new">Palavra-passe nova</label>
        <InputText id="new" class="field" @bind-Value="Input.NewPassword" type="password" autocomplete="new-password" />
        <ValidationMessage For="() => Input.NewPassword" class="auth-validation" />
    </div>

    <div class="auth-field">
        <label for="confirm">Confirmar palavra-passe nova</label>
        <InputText id="confirm" class="field" @bind-Value="Input.ConfirmPassword" type="password" autocomplete="new-password" />
        <ValidationMessage For="() => Input.ConfirmPassword" class="auth-validation" />
    </div>

    <button type="submit" class="btn btn-primary auth-submit">Guardar</button>
</EditForm>

<p class="auth-alt"><a href="">Voltar à agenda</a></p>

@code {
    private List<string> _errors = [];
    private bool _done;

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromForm]
    private ChangePasswordModel Input { get; set; } = new();

    private async Task ChangeAsync()
    {
        AgenderUser? user = await UserManager.GetUserAsync(HttpContext.User);
        if (user is null)
        {
            Navigation.NavigateTo("/conta/entrar", forceLoad: true);
            return;
        }

        IdentityResult result = await UserManager.ChangePasswordAsync(user, Input.CurrentPassword, Input.NewPassword);

        if (!result.Succeeded)
        {
            _errors = [.. result.Errors.Select(e => e.Description)];
            return;
        }

        await SignInManager.RefreshSignInAsync(user);
        _errors = [];
        _done = true;
        Input = new ChangePasswordModel();
    }

    private sealed class ChangePasswordModel
    {
        [Required(ErrorMessage = "Indica a palavra-passe atual.")]
        public string CurrentPassword { get; set; } = string.Empty;

        [Required(ErrorMessage = "Indica a palavra-passe nova.")]
        public string NewPassword { get; set; } = string.Empty;

        [Required(ErrorMessage = "Confirma a palavra-passe nova.")]
        [Compare(nameof(NewPassword), ErrorMessage = "As palavras-passe não coincidem.")]
        public string ConfirmPassword { get; set; } = string.Empty;
    }
}
